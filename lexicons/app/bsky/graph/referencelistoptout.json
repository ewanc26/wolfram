{
  "lexicon": 1,
  "id": "app.bsky.graph.referencelistoptout",
  "defs": {
    "main": {
      "type": "record",
      "description": "Record requesting that its author be omitted from the public presentation of a reference list.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": { "type": "string", "format": "at-uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
